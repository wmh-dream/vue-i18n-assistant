{
  "name": "vue-i18n-assistant",
  "displayName": "Vue I18n Assistant",
  "version": "0.0.1",
  "description": "Vue 国际化助手:一键提取 Vue SFC 中的中文到 i18n 调用",
  "publisher": "assistant",
  "engines": {
    "vscode": "^1.89.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "vueI18nAssistant.convertCurrentVueFile",
        "title": "Vue I18n Assistant: Convert Current Vue File"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./ --noEmit && node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc -p ./ --noEmit",
    "package": "vsce package --no-dependencies"
  },
  "dependencies": {
    "@assistant/core": "workspace:*",
    "@vue/compiler-sfc": "^3.5.40"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.89.0",
    "@vscode/vsce": "^2.32.0",
    "esbuild": "^0.23.0",
    "typescript": "^5.4.0"
  }
}
